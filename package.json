{
  "name": "@eovoc/schema-viewer",
  "version": "0.1.0",
  "description": "React component that shows the definitions of a JSON Schema as interactive UML class diagrams.",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eovoc/schema-viewer.git"
  },
  "type": "module",
  "main": "./lib-dist/schema-viewer.js",
  "types": "./lib-dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-dist/index.d.ts",
      "import": "./lib-dist/schema-viewer.js"
    },
    "./style.css": "./lib-dist/style.css"
  },
  "files": [
    "lib-dist",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build:lib",
    "predeploy": "npm run build:demo",
    "deploy": "gh-pages -d dist --nojekyll"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "gh-pages": "^6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
